+	add_filter( 'woocommerce_product_class', $broken_class209, 10, 4 );
+	try { $retry209 = Mutator209::apply( $retry_plan209, $id209 ); }
+	finally { remove_filter( 'woocommerce_product_class', $broken_class209, 10 ); }
