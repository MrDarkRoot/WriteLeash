 10px;font-size:.9em}.bulk-price-editor-button--small .dashicons{font-size:14px;width:14px;height:14px;margin-top:3px}.bulk-price-editor-settings{width:100%;max-width:700px;background:#fff;border:1px solid var(--bulk-price-editor-dark-grey, #dcdcde);border-radius:6px}.bulk-price-editor-settings__section{padding:20px}.bulk-price-editor-settings__title{font-size:1.1em;font-weight:700;margin-bottom:15px}.bulk-price-editor-settings__footer{padding:15px 20px;background:var(--bulk-price-editor-grey, #f6f6f6);border-top:1px solid var(--bulk-price-editor-dark-grey, #dcdcde)}.bulk-price-editor-modal-popup__schedule{padding:0 20px 10px}.bulk-price-editor-modal-popup__schedule .bpe-schedule-modes{display:flex;gap:20px;margin-bottom:12px}.bulk-price-editor-modal-popup__schedule .bpe-schedule-mode{display:flex;align-items:center;gap:6px;font-weight:600}.bulk-price-editor-modal-popup__schedule .bpe-schedule-field{margin-bottom:10px}.bulk-price-editor-modal-popup__schedule .bpe-schedule-field label{display:block;font-weight:600;margin-bottom:4px}.bulk-price-editor-modal-popup__schedule .bpe-schedule-field input[type=datetime-local]{min-width:220px}.bulk-price-editor-modal-popup__schedule .bpe-schedule-field .description{margin:4px 0 0;color:#646970}.bulk-price-editor-modal-popup__schedule .bpe-schedule-timezone{margin:6px 0 0;color:#646970}.bulk-price-editor__inner{display:flex;padding:20px;justify-content:center;align-items:center;gap:20px;flex-wrap:wrap}.bulk-price-editor-plan-badge{padding:3px 6px;background:#333;color:#fff;font-size:.8em;border-radius:3px}
