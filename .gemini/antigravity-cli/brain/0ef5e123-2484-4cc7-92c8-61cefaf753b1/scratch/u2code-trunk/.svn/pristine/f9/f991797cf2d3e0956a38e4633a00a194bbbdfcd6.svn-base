 svg{font-size:1.3em;width:30px}.bulk-price-editor-update-in-progress__description{margin-top:20px;text-align:center}.bulk-price-editor-update-in-progress__progress{margin-top:20px}.bulk-price-editor-update-in-progress__info{display:flex;justify-content:space-between;font-weight:500;margin-bottom:5px}.bulk-price-editor-progress-bar{height:20px;overflow:hidden;border-radius:4px;background:var(--bulk-price-editor-grey)}.bulk-price-editor-progress-bar__inner{height:20px;background:var(--bulk-price-editor-dark-grey);width:30%}@media screen and (max-width: 1024px){.bulk-price-editor-update-in-progress{flex:0 1 100%}}.bulk-price-editor-header{display:flex;flex-wrap:wrap;align-items:stretch;gap:0 24px;min-height:60px;padding:0 30px;background:#fff;border-bottom:1px solid var(--bulk-price-editor-dark-grey)}.bulk-price-editor-header__brand{display:flex;align-items:baseline;gap:8px;align-self:center;padding:14px 24px 14px 0;border-right:1px solid var(--bulk-price-editor-dark-grey)}.bulk-price-editor-header__title{font-size:15px;font-weight:700;color:#1d2327;white-space:nowrap}.bulk-price-editor-header__actions{display:flex;align-items:center;gap:16px;margin-left:auto;align-self:center;padding:10px 0}.bulk-price-editor-header__plan{display:inline-flex;align-items:center;gap:3px;font-size:12px;font-weight:600;color:#646970;white-space:nowrap}.bulk-price-editor-header__plan .dashicons{font-size:15px;width:15px;height:15px}.bulk-price-editor-header__plan--premium{color:#007017}.bulk-price-editor-header__link{font-size:13px;font-weight:500;color:#50575e;text-decoration:none;white-space:nowrap}.bulk-price-editor-header__link:hover{color:#135e96}.bulk-price-editor-header .bulk-price-editor-button--upgrade{animation:none;background:#059669;color:#fff;box-shadow:none}.bulk-price-editor-header .bulk-price-editor-button--upgrade:hover{animation:none;background:#047857;color:#fff}.bulk-price-editor-header .bulk-price-editor-button--upgrade .dashicons{font-size:16px;width:16px;height:16px