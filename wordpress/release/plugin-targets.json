{
  "writeleash": {
    "root": "wordpress/writeleash",
    "main": "writeleash.php",
    "name": "WriteLeash",
    "namespace": "WriteLeash",
    "version": "0.1.0",
    "text_domain": "writeleash",
    "manifest": "wordpress/release/writeleash-distribution-files.txt",
    "assets": "wordpress/assets",
    "release": "wordpress/release",
    "tests": "wordpress/tests",
    "requires_wp": "7.0",
    "requires_php": "7.4"
  },
  "price-history": {
    "root": "wordpress/writeleash-price-history",
    "main": "writeleash-price-history.php",
    "name": "WriteLeash Price History (isolation scaffold)",
    "namespace": "WriteLeash\\PriceHistory",
    "version": "0.0.0",
    "text_domain": "writeleash-price-history",
    "manifest": "wordpress/release/price-history/distribution-files.txt",
    "asset_manifest": "wordpress/release/price-history/assets-files.txt",
    "assets": "wordpress/assets/price-history",
    "release": "wordpress/release/price-history",
    "tests": "wordpress/tests/price-history",
    "requires_wp": "7.0",
    "requires_php": "7.4",
    "table_prefix": "writeleash_price_history_",
    "option_prefix": "writeleash_price_history_",
    "scheduler_group": "writeleash-price-history",
    "action_hook": "writeleash_price_history_wakeup",
    "rest_namespace": "writeleash-price-history/v1"
  },
  "price-campaigns": {
    "root": "wordpress/writeleash-price-campaigns",
    "main": "writeleash-price-campaigns.php",
    "name": "WriteLeash Price Campaigns (isolation scaffold)",
