    "asset_manifest": "wordpress/release/price-campaigns/assets-files.txt",
    "assets": "wordpress/assets/price-campaigns",
    "release": "wordpress/release/price-campaigns",
    "tests": "wordpress/tests/price-campaigns",
    "requires_wp": "7.0",
    "requires_php": "7.4",
    "table_prefix": "writeleash_price_campaigns_",
    "option_prefix": "writeleash_price_campaigns_",
    "scheduler_group": "writeleash-price-campaigns",
    "action_hook": "writeleash_price_campaigns_wakeup",
    "rest_namespace": "writeleash-price-campaigns/v1"
  }
